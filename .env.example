# Copy to .env and fill in. Nothing here is a secret — placeholders only.
# Only DATABASE_URL is needed for local development; everything else can
# stay empty and the app runs with that feature disabled (auth routes
# raise a clear error if used, /assistant/query 503s, telemetry no-ops).

# --- Database (compose.yaml runs Postgres 16 on localhost:5432) ---
DATABASE_URL=postgresql+asyncpg://tracker:tracker@localhost:5432/tracker

# --- Entra ID SSO ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Application ID URI the API accepts as audience (defaults to api://<client-id>).
ENTRA_API_URI=

# Origins allowed to call the API from the browser (JSON list).
CORS_ORIGINS=["http://localhost:3000"]

# --- Telemetry (empty = no-op) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Assistant: AI Search retrieval. Endpoint/key presence gates the
# --- /assistant/query route (503 without it). ---
AI_SEARCH_ENDPOINT=
AI_SEARCH_KEY=
AI_SEARCH_INDEX=help-docs

# --- Assistant: generation. Presence of LLM_API_KEY IS the flag: with it
# --- set, answers are generated; without it, citations only. Provider-
# --- neutral (OpenAI-compatible chat completions), defaults to DeepSeek
# --- (docs/adr/0004) — moving providers is a base URL and model away.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# --- Embeddings: local fastembed (ONNX). Empty cache dir = default. ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=
